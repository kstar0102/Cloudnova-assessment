# Required only for `ask`, `demo` and the NL eval layer. `build` and `pytest` need nothing.
ANTHROPIC_API_KEY=

# Optional overrides (defaults shown)
# CLOUDNOVA_MODEL=claude-opus-5-5
# CLOUDNOVA_EFFORT=medium
# CLOUDNOVA_FX_MODE=multiply        # multiply (as written in BUSINESS_CONTEXT) | divide (what the data implies; see docs/data_profile.md F7)
# CLOUDNOVA_RAW_CSV=data/cloudnova_invoices.csv
# CLOUDNOVA_DB_PATH=build/cloudnova.duckdb
# CLOUDNOVA_RUN_DATE=2026-11-20     # used for is_future_dated; defaults to today
